# Copy to .env for Docker Compose. Replace both placeholders before starting.
# Generate SECRET_KEY locally, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
SUPER_ADMIN_EMAIL=

# SMTP is required for notifications. Empty SMTP_HOST leaves delivery disabled.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
MAIL_FROM=review@example.com
SITE_BASE_URL=http://localhost:8000

# Optional Cloudflare Tunnel token; configure only when using that service.
CLOUDFLARE_TUNNEL_TOKEN=

# Local backend development only: place this .env in backend/ when running there.
# Docker Compose currently supplies its own DATABASE_URL, REDIS_URL and UPLOAD_DIR.
# Other settings below are read by the backend, but are not forwarded by Compose;
# add them to app.environment if overriding them in a container deployment.
DATABASE_URL=postgresql+psycopg://review:review@localhost:5432/review
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
TIMEOUT_HOURS=72
CYCLE_THRESHOLD=3
GLOBAL_REASSIGN_THRESHOLD=5
CRON_INTERVAL_MINUTES=5
